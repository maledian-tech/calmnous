# Required in production. In development, payload.config falls back if unset (never ship that).
PAYLOAD_SECRET=

# Payload hooks the dev HMR websocket; that can race with Next 16 RSC refresh ("Failed to fetch").
# Default is on (via next.config). Set to false only if you need Payload admin hot-reload of config.
# DISABLE_PAYLOAD_HMR=true

# Local dev: SQLite file. Production (Vercel): set DATABASE_URL to postgres:// or postgresql:// (...?sslmode=require is OK for Postgres, not for SQLite).
# Vercel Postgres also sets POSTGRES_URL / POSTGRES_PRISMA_URL — those are used if DATABASE_URL is empty, or in production if DATABASE_URL is still file:...
# Do not wrap the URL in quotes in the Vercel UI. Adapter selection: payload.config.ts
# Production Postgres runs migrations from ./migrations (prodMigrations). After collection changes: npx payload migrate:create <name> --disable-transpile, update migrations/index.ts, commit.
DATABASE_URL=file:payload.db

# Homepage media (see /public/hero/: hero-loop.mp4, hero-poster.jpg). Override with:
# NEXT_PUBLIC_HERO_VIDEO_URL=/hero/hero-loop.mp4
# NEXT_PUBLIC_HERO_POSTER_URL=none

# Branding in /public: calmnous-logo.jpeg or logo.png

# `npm run db:reset` deletes the SQLite file from DATABASE_URL. On Windows (EBUSY), stop `next dev` first.

# Payload SQLite init errors (e.g. "CREATE UNIQUE INDEX ... services_slug", or "index ... already exists"): stop dev, `npm run db:reset`, dev, `npm run seed`.

# Contact / footer (optional overrides)
NEXT_PUBLIC_CONTACT_EMAIL=hello@calmnous.com
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/yourhandle
# NEXT_PUBLIC_INSTAGRAM_HANDLE=@yourhandle
# BACP Register number (displayed in footer)
# NEXT_PUBLIC_BACP_REGISTRATION=000000
# Footer logos default to /public/logos/bacp-logo-official.svg and bps-logo-official.svg (org sites).
# Run `npm run logos:bacp` / `npm run logos:bps` to refresh from each site (markup may change). Use only as permitted.
# NEXT_PUBLIC_BACP_LOGO_SRC=/logos/bacp-logo-official.svg
# NEXT_PUBLIC_BPS_LOGO_SRC=/logos/bps-logo-official.svg
# NEXT_PUBLIC_BPS_FOOTER_CAPTION=Your custom line about BPS (e.g. membership grade).

# SimplyBook company URL — powers the /book page embed.
# Set to your SimplyBook URL, e.g.: https://calmnous.simplybook.me
# NEXT_PUBLIC_SIMPLYBOOK_URL=https://calmnous.simplybook.me

# External booking URL override (header + hero + contact CTAs).
# If unset, all "Book a session" CTAs link to the internal /book page.
# Only set this if you want to bypass the /book page entirely (e.g. a direct SimplyBook link).
# NEXT_PUBLIC_BOOKING_URL=

# Canonical site origin (optional). Prefixes relative media URLs from Payload where needed.
# NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: populate sample services (SQLite file must match DATABASE_URL above)
# npm run seed
